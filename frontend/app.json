{
  "expo": {
    "name": "UDAMG",
    "slug": "udamg-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "udamg",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.churchconnect.u28idv",
      "infoPlist": {}
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.udamg.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/material-design-icons",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Autoriser UDAMG à utiliser la caméra pour scanner les badges QR"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choisir des pochettes et vidéos pour les médias",
          "cameraPermission": "Autoriser UDAMG à utiliser la caméra pour scanner les badges QR"
        }
      ],
      "expo-audio",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/adaptive-icon.png",
          "color": "#0047AB"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
